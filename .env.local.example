# Base configuration - committed to version control (no secrets here)
IS_LOCAL=true
DEBUG=false

# CampusAI / OpenAI-compatible API
# Fill in .env.local with your actual credentials
# Get API key from https://api.campusai.compute.dtu.dk/
CAMPUSAI_API_KEY=
CAMPUSAI_API_URL=https://api.campusai.compute.dtu.dk/v1/
CAMPUSAI_MODEL=google/gemma-4-26b-a4b
CAMPUSAI_EMBED_MODEL=nomic/nomic-embed-text

# OpenAI API key
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Kaggle
KAGGLE_API_TOKEN=

